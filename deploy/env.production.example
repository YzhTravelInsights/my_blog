# ============================================================================
# 服务器生产环境变量模板
#
# 用法：复制本文件内容，生成 .deploy/server.env（该路径已被 .gitignore 忽略），
#       deploy.ps1 会把它上传并以 600 权限装到服务器 backend/.env。
#
#   OWNER_SECRET / ADMIN_KEY 生成：
#       python -c "import secrets;print(secrets.token_hex(32))"
#
# 注意：Linux 上无法解密 Windows DPAPI 密文，所以这里必须用明文变量
#       DEEPSEEK_API_KEY（不要填 DEEPSEEK_API_KEY_ENC）。
#       backend/modules/security.py 在非 Windows 上会自动回退读明文。
# ============================================================================

# DeepSeek API Key（明文；服务器上该文件权限 600，仅 blog 用户可读）
DEEPSEEK_API_KEY=sk-在这里填你的key

DEEPSEEK_BASE_URL=https://api.deepseek.com
FLASK_ENV=production

# 主人模式鉴权密钥（Bearer Token），务必用随机值
OWNER_SECRET=在这里填随机密钥
ADMIN_KEY=在这里填随机密钥

# ── 每日 API 花费限额 ────────────────────────────────────────────
# 访客（公开 /api/chat）每天最多花多少元；主人模式（/api/chat/owner）不受限制。
# 0 或负数 = 不限制。用尽后访客收到友好提示，且不再调用 DeepSeek（零成本）。
QUOTA_DAILY_CNY=1.0
# 单价（元 / 百万 token），默认按 DeepSeek deepseek-chat 官方价，可随价目调整
DEEPSEEK_PRICE_INPUT_MISS=2.0
DEEPSEEK_PRICE_INPUT_HIT=0.5
DEEPSEEK_PRICE_OUTPUT=8.0

# 下面两个变量 config.py 其实不读（路径由 PROJECT_ROOT 推导），
# 保留仅为兼容旧部署习惯，可留空。
# DATABASE_PATH=./data/blog.db
# CHROMA_PERSIST_DIR=./data/chroma
