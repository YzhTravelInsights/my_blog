# ── DeepSeek API Key ─────────────────────────────────────────────
# 推荐「加密存储」：先运行一次下面的命令生成密文，再填入 DEEPSEEK_API_KEY_ENC：
#   python -c "from modules.security import encrypt_secret; print(encrypt_secret('sk-你的key'))"
# 运行时由 modules.security.get_deepseek_api_key() 在进程内解密一次并缓存，
# 明文不会落盘 / 进 git / 打日志（Windows DPAPI 绑定当前用户，换机器/用户需重新生成）。
#
# 明文方式仅用于本地测试（modules/security 也兼容读取）：
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_KEY_ENC=
DEEPSEEK_BASE_URL=https://api.deepseek.com
FLASK_ENV=development
DATABASE_PATH=./data/blog.db
CHROMA_PERSIST_DIR=./data/chroma
OWNER_SECRET=your_owner_secret_here
ADMIN_KEY=your_admin_key_here
